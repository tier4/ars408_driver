<launch>
  <!-- launch flags -->
  <arg name="launch_driver" default="true" />

  <!-- SocketCAN params (single CAN bus shared by all radars) -->
  <arg name="can_interface"        default="can0" />
  <arg name="receiver_interval_sec" default="0.01" />
  <arg name="can_raw_topic"
    default="/sensing/radar/can_raw" />

  <!-- Radar 0: Sensor ID=0 -->
  <arg name="radar0/radar_id"     default="0" />
  <arg name="radar0/output_frame" default="ars408_0" />
  <arg name="radar0/config_file"
    default="$(find-pkg-share pe_ars408_ros)/config/ars408_driver.param.yaml" />

  <!-- Radar 1: Sensor ID=1 -->
  <arg name="radar1/radar_id"     default="1" />
  <arg name="radar1/output_frame" default="ars408_1" />
  <arg name="radar1/config_file"
    default="$(find-pkg-share pe_ars408_ros)/config/ars408_driver.param.yaml" />

  <!-- Single SocketCAN bridge: publishes all frames to one topic -->
  <include
    file="$(find-pkg-share ros2_socketcan)/launch/socket_can_receiver.launch.py"
    if="$(var launch_driver)">
    <arg name="interface"          value="$(var can_interface)" />
    <arg name="interval_sec"       value="$(var receiver_interval_sec)" />
    <arg name="from_can_bus_topic" value="$(var can_raw_topic)" />
  </include>

  <!-- ARS408 driver node for radar 0
       Subscribes to the shared CAN topic and ignores frames from other Sensor IDs -->
  <group>
    <push-ros-namespace namespace="radar0" />
    <include file="$(find-pkg-share pe_ars408_ros)/launch/continental_ars408.launch.xml">
      <arg name="input/frame" value="$(var can_raw_topic)" />
      <arg name="config_file" value="$(var radar0/config_file)" />
    </include>
    <param name="pe_ars408_node/radar_id"     value="$(var radar0/radar_id)" />
    <param name="pe_ars408_node/output_frame" value="$(var radar0/output_frame)" />
  </group>

  <!-- ARS408 driver node for radar 1
       Subscribes to the shared CAN topic and ignores frames from other Sensor IDs -->
  <group>
    <push-ros-namespace namespace="radar1" />
    <include file="$(find-pkg-share pe_ars408_ros)/launch/continental_ars408.launch.xml">
      <arg name="input/frame" value="$(var can_raw_topic)" />
      <arg name="config_file" value="$(var radar1/config_file)" />
    </include>
    <param name="pe_ars408_node/radar_id"     value="$(var radar1/radar_id)" />
    <param name="pe_ars408_node/output_frame" value="$(var radar1/output_frame)" />
  </group>
</launch>
